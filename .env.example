# Local Ollama model used by every LLM agent (via ADK's LiteLlm adapter).
SAFESPEAK_MODEL=ollama_chat/qwen2.5:3b
OLLAMA_API_BASE=http://localhost:11434
# Where structured traces are written (one JSON object per line).
SAFESPEAK_LOG_PATH=logs/trace.jsonl
# Where the run monitor and the A2A server listen (local only by default).
# Use 0.0.0.0 only behind HTTPS and a login: neither server has authentication.
SAFESPEAK_UI_HOST=127.0.0.1
SAFESPEAK_UI_PORT=8765
SAFESPEAK_A2A_HOST=127.0.0.1
SAFESPEAK_A2A_PORT=8010
# Address other agents use to reach the A2A server (written into its agent card).
SAFESPEAK_A2A_PUBLIC_URL=http://127.0.0.1:8010
